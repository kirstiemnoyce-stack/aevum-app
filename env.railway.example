# ============================================================
# AEVUM — Environment Variables (Railway variant)
# ============================================================
# For Railway deployment, set these in Railway dashboard:
# https://railway.app/project/[your-project]/variables
# ============================================================

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Database (Railway MySQL) ---
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/aevum

# --- App Security ---
# Generate at https://generate-secret.vercel.app/32
APP_SECRET=generate-a-random-32-char-secret-here

# --- App URL (optional) ---
APP_URL=https://aevum.app

# --- Kimi App Identity ---
VITE_APP_ID=your-app-id-here
VITE_KIMI_AUTH_URL=https://kimi-auth.moonshot.cn
KIMI_AUTH_URL=https://kimi-auth.moonshot.cn
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=your-union-id-here
